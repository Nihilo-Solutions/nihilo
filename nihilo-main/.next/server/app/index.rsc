27:["$","ul",null,{"className":"text-zinc-500 text-[13px] mb-4 space-y-2","children":[["$","li",null,{"children":"Define agent goals and safety constraints using reusable governance templates."}],["$","li",null,{"children":"Orchestrate agents with event-driven serverless patterns for reliability and idempotency."}],["$","li",null,{"children":"Integrate with ticketing, CI and observability stacks while enforcing RBAC and separation of duties."}]]}]
28:["$","h5",null,{"className":"text-sm text-zinc-300 uppercase tracking-wider mb-2","children":"Key benefits & KPIs"}]
29:["$","ul",null,{"className":"text-zinc-500 text-[13px] space-y-2","children":[["$","li",null,{"children":"Typically reduces manual steps by 60–85% in back-office operations based on our Azure deployments."}],["$","li",null,{"children":"Decrease Mean Time To Resolution (MTTR) by typically 30–70% through automated triage and remediation."}],["$","li",null,{"children":"Full auditability: 100% of agent actions are logged, traceable, and replayable for compliance."}]]}]
