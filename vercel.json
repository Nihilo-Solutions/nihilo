{
  "headers": [
    {
      "source": "/(.*).(jpg|png|svg|pdf|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|_vercel|robots\\.txt|sitemap\\.xml|.*\\.(?:png|jpg|pdf|svg|webp|ico)).*)",
      "destination": "/index.html"
    }
  ]
}